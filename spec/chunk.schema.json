{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chunk.json v1",
  "type": "object",
  "required": ["schema_version", "document", "run", "nodes", "chunks", "quality", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "document": {
      "type": "object",
      "required": ["doc_id", "file_hash", "source_file", "page_count", "parser"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {"type": "string", "minLength": 1},
        "file_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_file": {"type": "string", "minLength": 1},
        "page_count": {"type": "integer", "minimum": 1},
        "parser": {"$ref": "#/$defs/named_version"}
      }
    },
    "run": {
      "type": "object",
      "required": ["run_id", "chunker", "spec_version", "tokenizer", "created_at"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "chunker": {
          "type": "object",
          "required": ["name", "version", "settings"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "settings": {"type": "object"}
          }
        },
        "spec_version": {"type": "string", "minLength": 1},
        "tokenizer": {
          "type": "object",
          "required": ["name", "revision"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1}
          }
        },
        "created_at": {"type": "string", "minLength": 1}
      }
    },
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "chunks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chunk"}},
    "quality": {
      "type": "object",
      "required": ["layer1", "layer2"],
      "properties": {
        "layer1": {"type": "object"},
        "layer2": {"type": "object"}
      }
    },
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "named_version": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "id_or_null": {"type": ["string", "null"]},
    "node": {
      "type": "object",
      "required": ["node_id", "parent_id", "level", "title", "start_char", "end_char"],
      "additionalProperties": false,
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "parent_id": {"$ref": "#/$defs/id_or_null"},
        "level": {"type": "integer", "minimum": 0},
        "title": {"type": "string"},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 0}
      }
    },
    "chunk": {
      "type": "object",
      "required": ["chunk_id", "text", "start_char", "end_char", "pages", "section_path", "token_count",
                   "prefix", "prefix_token_count", "prev_id", "next_id", "parent_node_id", "content_type", "errors"],
      "additionalProperties": false,
      "properties": {
        "chunk_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 1},
        "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "section_path": {"type": "array", "items": {"type": "string"}},
        "token_count": {"type": "integer", "minimum": 1},
        "prefix": {"type": ["string", "null"]},
        "prefix_token_count": {"type": "integer", "minimum": 0},
        "prev_id": {"$ref": "#/$defs/id_or_null"},
        "next_id": {"$ref": "#/$defs/id_or_null"},
        "parent_node_id": {"$ref": "#/$defs/id_or_null"},
        "content_type": {"enum": ["prose", "table", "list"]},
        "errors": {"type": "array", "uniqueItems": true, "items": {"enum": ["C1", "C2", "C3", "C4", "C5", "C6"]}}
      }
    },
    "edge": {
      "type": "object",
      "required": ["source_id", "target_id", "type"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1}
      }
    }
  }
}
